{
  "name": "whiplash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slack-style stage that takes over your Claude Code and Codex sessions, wherever they started.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "desktop": "electron .",
    "dist": "electron-builder --mac",
    "test": "node --test \"src/**/*.test.ts\" \"public/**/*.test.js\" \"desktop/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "electron": "43.8.6",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "agent-browser": "0.39.4",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.jingi723.whiplash",
    "productName": "Whiplash",
    "directories": {
      "buildResources": "build",
      "output": "dist.noindex"
    },
    "files": [
      "desktop/**",
      "src/**",
      "!src/**/*.test.ts",
      "!src/orca/vitest.ts",
      "public/**",
      "!public/**/*.test.js",
      "package.json",
      "!node_modules/agent-browser/bin/agent-browser-{linux,win32}*"
    ],
    "asar": false,
    "npmRebuild": false,
    "publish": null,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false
    }
  }
}
