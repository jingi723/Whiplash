{
  "name": "whiplash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slack-style stage that takes over your Claude Code and Codex sessions, wherever they started.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test \"src/**/*.test.ts\" \"public/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2"
  }
}
